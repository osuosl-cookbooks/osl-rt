#!/bin/bash
# Inject a message through postfix -> procmail and wait for it to arrive where
# expected. InSpec must invoke this as a single command: train applies the
# verifier's sudo by prefixing it to the command string, so only the first
# pipeline of a multi-line inline script runs as root -- everything after runs
# as the unprivileged ssh user and cannot read the 0700 maildirs.
#
# Usage: osl-rt-test-mail <recipient> <subject> <expect> [header]...
#   expect: a directory to search for the subject (a maildir new/), or
#           'ticket' to poll the RT ticket list instead.
recipient=$1 subject=$2 expect=$3
shift 3

# Send as root@localhost: a fresh RT database grants unknown senders no
# CreateTicket right (rt-mailgate gets Permission Denied and procmail's
# no-w pipe swallows it), and root@localhost is the initial RT superuser's
# address -- the one sender a bare database tickets mail from. The mailx
# round trip relies on the same fact.
{
  printf 'From: root@localhost\n'
  printf 'To: %s\n' "$recipient"
  printf 'Subject: %s\n' "$subject"
  for header in "$@"; do printf '%s\n' "$header"; done
  printf 'Date: %s\n' "$(date -R)"
  printf '\nTest message body.\n'
} | /usr/sbin/sendmail -i -f root@localhost "$recipient" || exit 2

for _ in $(seq 1 30); do
  if [ "$expect" = ticket ]; then
    HOSTALIASES=/root/.rthost /opt/rt/bin/rt ls -t ticket -f Subject 2>/dev/null \
      | grep -q "$subject" && exit 0
  else
    grep -rq "$subject" "$expect" 2>/dev/null && exit 0
  fi
  sleep 2
done

echo "'$subject' did not arrive in $expect; recent maillog:" >&2
tail -n 30 /var/log/maillog >&2
exit 1
