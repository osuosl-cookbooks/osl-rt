DEFAULT=$HOME/Mail/
PATH=/usr/local/bin:/usr/bin:/bin
MAILDIR=$HOME/Mail/
LOGFILE=$MAILDIR/from
HOSTALIASES=$HOME/.rthost

:0:
* ^X-Spam-Status: Yes
.Spam/

:0:
* ^From: MAILER-DAEMON@<%= @mail_domain %>
/dev/null

<% if @forward_email -%>
:0 c
! <%= @forward_email %>

<% end -%>
<% @rt_queues.each do |queue, email| -%>
<%- next if !email -%>
:0:.rt-mailparse.lock
* ^X-Original-To: <%= email %>@<%= @domain_match %>
| /opt/rt/bin/rt-mailgate --queue "<%= queue %>" --action correspond --url http://<%= @internal_domain %>

:0:.rt-mailparse.lock
* ^X-Original-To: <%= email %>-comment@<%= @domain_match %>
| /opt/rt/bin/rt-mailgate --queue "<%= queue %>" --action comment --url http://<%= @internal_domain %>
<% end -%>

:0f
| /bin/sed -e 's/^Subject:/Subject: [RT FAILED]/g'

:0
! <%= @error_email %>
